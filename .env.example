# ==============================================================================
# Voice Commerce Assistant - Environment Configuration (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# --- Node & Environment ---
NODE_ENV=development
PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
DEMO_TENANT_PORT=4000
LOG_LEVEL=info

# --- Database & Cache ---
DATABASE_URL=postgres://vca_user:vca_password@localhost:5432/vca_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vca:

# --- Cryptography & Security ---
SESSION_SIGNING_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_TOKEN_TTL_SECONDS=7200
DEV_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Unified Hosted LLM Configuration ---
# Single point of configuration: change LLM_PROVIDER, LLM_MODEL, and LLM_API_KEY
# Supported providers: groq, xai, openai, gemini, mock
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key_here

# Provider-Specific Presets (Switch seamlessly by setting LLM_PROVIDER)
# GroqCloud (Free & Ultra-fast LPU inference)
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_ID=llama-3.3-70b-versatile
GROQ_FAST_MODEL_ID=llama-3.1-8b-instant
GROQ_API_KEY=

# xAI Grok (Grok-2 / Grok-2 mini)
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL_ID=grok-2-mini
XAI_API_KEY=

# OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_API_KEY=

# Google Gemini (Gemini 2.0 Flash / Pro via OpenAI compatibility endpoint)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_ID=gemini-2.0-flash
GEMINI_API_KEY=

# LLM Rate Governor & Budgets
LLM_MAX_RPM=30
LLM_MAX_TPM=10000
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS_PER_TURN=400

# --- Speech Providers (Phase 6) ---
STT_PROVIDER=mock
STT_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=

# --- Rate Limiting & Abuse Prevention ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS_PER_IP=120
RATE_LIMIT_MAX_REQUESTS_PER_TENANT=1000
MAX_CONCURRENT_SESSIONS_PER_TENANT=100

# --- Data Retention ---
TRANSCRIPT_RETENTION_DAYS=7
PROPOSAL_TTL_SECONDS=120
REDACT_PII_IN_LOGS=true

{
  "name": "voice-commerce-assistant-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generic, Multi-Tenant Voice Commerce Assistant Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types start-all.js",
    "dev": "node --experimental-strip-types start-all.js",
    "build": "pnpm -r --filter=!./tools/* build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"{apps,packages,tools}/**/*.ts*\"",
    "lint:fix": "eslint \"{apps,packages,tools}/**/*.ts*\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test -- --coverage",
    "audit:deps": "pnpm audit --audit-level=high",
    "clean": "pnpm -r exec rm -rf dist coverage node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
